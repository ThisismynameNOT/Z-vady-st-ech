# Public site / TinaCloud
PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=
# Optional until a real Worker/custom-domain URL exists. For local development use http://localhost:4321.
SITE_URL=

# Cloudinary (server-side secrets except cloud name)
PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=zavady-strech

# Enquiry delivery
RESEND_API_KEY=
FORM_RECIPIENT_EMAIL=
FORM_FROM_EMAIL=

# Optional Cloudflare Turnstile
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare deployment credentials (GitHub Actions / local CLI only, never committed)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
