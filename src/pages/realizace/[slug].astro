---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getProject, getCompany } from '../../lib/content'; import { money } from '../../lib/format'; const p=getProject(Astro.params.slug||''); if(!p) return Astro.redirect('/404/'); const company=getCompany();
---
<BaseLayout title={p.seoTitle||`${p.title} | ${company.companyName}`} description={p.seoDescription||p.shortDescription||''} canonicalUrl={`/realizace/${p.slug}/`} ogImage={p.heroImage} schemaType="Article"><section class="subhero has-image"><div class="bg"><img src={p.heroImage} alt="" fetchpriority="high" /></div><div class="wrap"><div class="breadcrumbs"><a href="/">Domů</a> / <a href="/realizace/">Realizace</a> / {p.title}</div><div class="kicker" style="margin-top:28px;color:var(--brass2)">Realizace · {p.year}</div><h1>{p.title}</h1><p>{p.shortDescription}</p></div></section><article class="case"><div class="wrap case-grid"><div class="case-media"><img src={p.heroImage} alt={p.imageAlt||p.title} />{p.imageCaption&&<div class="caption">{p.imageCaption}</div>}</div><div class="case-copy"><div class="case-no">{p.location}</div><h2>Rozsah práce</h2><p class="scope">{p.fullDescription}</p><div class="fact-grid"><div class="fact"><b>{p.year}</b><span>rok</span></div>{p.contractValue&&<div class="fact"><b>{money(p.contractValue,p.currency)}</b><span>bez DPH</span></div>}</div>{p.registryLinks?.map((r:any)=><a class="btn btn-dark" href={r.url} target="_blank" rel="noopener">{r.label} ↗</a>)}</div></div>{p.gallery?.length>0&&<div class="project-page-gallery"><h2 class="h2">Fotografie</h2><div class="gallery-grid">{p.gallery.map((img:any)=><figure><img src={img.src} alt={img.alt||''} loading="lazy" />{img.caption&&<figcaption class="small muted">{img.caption}</figcaption>}</figure>)}</div></div>}{p.beforeImages?.length>0&&p.afterImages?.length>0&&<div class="project-page-gallery"><h2 class="h2">Před / po</h2><div class="before-after"><img src={p.beforeImages[0].src} alt={p.beforeImages[0].alt||'Před opravou'} /><img src={p.afterImages[0].src} alt={p.afterImages[0].alt||'Po opravě'} /></div></div>}</article><section class="final-cta"><div class="wrap final-grid"><div><div class="kicker" style="color:var(--brass2)">Kontakt</div><h2>Máte podobný problém?</h2></div><div class="final-contact"><a class="btn btn-primary" href="/kontakt/">Poptat opravu</a></div></div></section></BaseLayout>
