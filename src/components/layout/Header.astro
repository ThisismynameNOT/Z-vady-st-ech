---
import { getCompany, getSite } from '../../lib/content';
import { telHref } from '../../lib/format';
const company=getCompany(), site=getSite();
const path=Astro.url.pathname;
---
<a class="skip" href="#main">Přeskočit na obsah</a><div id="progress" class="progress"></div>
<header id="nav" class="nav"><div class="wrap nav-inner"><a class="brand" href="/" aria-label={`${company.companyName} – domů`}><span class="mark">Z</span><span class="brand-copy"><strong>{company.companyName}</strong><span>opravy · údržba · detail</span></span></a><nav class="top-links" aria-label="Hlavní navigace">{site.navigation.map((item:any)=><a href={item.href} aria-current={path===item.href?'page':undefined}>{item.label}</a>)}<a class="nav-phone" href={telHref(company.phone)}>{company.phone}</a><a class="nav-cta" href={site.primaryCTALink}>{site.primaryCTA}</a></nav><button class="menu-inline" data-menu-open aria-label="Otevřít menu" aria-controls="drawer">Menu</button></div></header>
<button class="side-trigger" data-menu-open aria-label="Otevřít boční menu" aria-controls="drawer">Menu</button><div id="drawerBackdrop" class="drawer-backdrop" data-menu-close></div><aside id="drawer" class="drawer" aria-hidden="true" aria-label="Boční navigace"><button class="drawer-close" data-menu-close aria-label="Zavřít menu">×</button><nav class="drawer-nav">{site.navigation.map((item:any,i:number)=><a href={item.href}><span>{String(i+1).padStart(2,'0')}</span>{item.label}</a>)}</nav><div class="drawer-contact"><div class="kicker">Potřebujete řešit střechu?</div><a class="phone-big" href={telHref(company.phone)}>{company.phone}</a><a class="small muted" href="/kontakt/">Odeslat poptávku →</a></div></aside>
