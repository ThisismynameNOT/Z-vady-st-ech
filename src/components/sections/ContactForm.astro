---
import { getCompany } from '../../lib/content'; import { telHref } from '../../lib/format'; const {heading}=Astro.props; const company=getCompany();
---
<section id="poptavka" class="section"><div class="wrap contact-grid"><aside class="contact-aside"><div class="kicker brass">Přímý kontakt</div><h2 style="margin-top:18px">{heading}</h2><div class="line"><div class="kicker muted">Telefon</div><a class="phone-big" href={telHref(company.phone)}>{company.phone}</a></div><div class="line"><div class="kicker muted">E-mail</div><a href={`mailto:${company.email}`}>{company.email}</a></div><div class="line"><div class="kicker muted">Adresa společnosti</div><span class="small">{company.address}</span></div><div class="line"><div class="kicker muted">Oblast</div><span class="small">{company.serviceArea}</span></div></aside><form id="roofForm" class="form-shell" novalidate><input class="hp-field" type="text" name="companyWebsite" id="companyWebsite" autocomplete="off" tabindex="-1" aria-hidden="true" style="position:absolute;left:-9999px"><input type="hidden" id="formStartedAt" value={Date.now()}><div class="form-top"><span>Poptávka střechy</span><span id="stepIndicator">Krok 1 / 3</span></div><div class="form-progress"><i id="stepProgress"></i></div><section class="form-step active"><h3>Jaký je objekt?</h3><div class="choices" data-key="building"><button type="button" class="choice" data-value="Rodinný / bytový dům">Rodinný / bytový dům</button><button type="button" class="choice" data-value="Komerční objekt">Komerční objekt</button><button type="button" class="choice" data-value="Veřejný objekt">Veřejný objekt</button><button type="button" class="choice" data-value="Historický objekt">Historický objekt</button></div></section><section class="form-step"><h3>Co potřebujete řešit?</h3><div class="choices" data-key="problem"><button type="button" class="choice" data-value="Zatékání / havarijní stav">Zatékání / havarijní stav</button><button type="button" class="choice" data-value="Oprava krytiny nebo detailu">Oprava krytiny nebo detailu</button><button type="button" class="choice" data-value="Údržba / kontrola">Údržba / kontrola</button><button type="button" class="choice" data-value="Práce ve výšce / jiný problém">Práce ve výšce / jiný problém</button></div></section><section class="form-step"><h3>Kam se můžeme ozvat?</h3><div class="fields"><div class="field"><label for="name">Jméno *</label><input id="name" name="name" type="text" autocomplete="name" maxlength="120" required></div><div class="field"><label for="phone">Telefon *</label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40" required></div><div class="field"><label for="email">E-mail *</label><input id="email" name="email" type="email" autocomplete="email" maxlength="180" required></div><div class="field"><label for="when">Preferovaný termín</label><select id="when" name="when"><option value="">Bez preference</option><option>Co nejdříve</option><option>Během několika dnů</option><option>Plánovaná údržba / později</option></select></div><div class="field full"><label for="location">Adresa / lokalita objektu</label><input id="location" name="location" type="text" autocomplete="street-address" maxlength="220"></div><div class="field full"><label for="note">Poznámka</label><textarea id="note" name="note" maxlength="3000" placeholder="Co se se střechou děje a co je důležité vědět."></textarea></div></div><p class="small muted">Souhrn: <span id="sumBuilding">—</span> · <span id="sumProblem">—</span></p><label class="privacy"><input id="privacyAck" type="checkbox"> <span>Seznámil/a jsem se s <a href="/ochrana-osobnich-udaju/">informacemi o zpracování osobních údajů</a>.</span></label></section><div class="form-actions"><button id="prevStep" class="btn" style="border-color:var(--line)" type="button">← Zpět</button><button id="nextStep" class="btn btn-dark" type="button">Pokračovat →</button></div><div id="formStatus" class="form-status" aria-live="polite"></div></form></div></section>
