---
import { getCompany, getProjects, getServices, getReferences } from '../../lib/content';
import { money, safeHref } from '../../lib/format';
import ContactForm from './ContactForm.astro';
const { section }=Astro.props; const company=getCompany(); const projects=getProjects(); const services=getServices(); const references=getReferences(); const t=section._template;
const lines=(s:string='')=>s.split('|');
const featuredProjects=projects.filter(p=>p.featured).slice(0,section.limit||3);
---
{t==='hero' && <section class="hero"><div class="hero-media">{section.backgroundImage==='/assets/images/hero-prague.jpg'?<picture style="display:block;width:100%;height:100%"><source type="image/avif" srcset="/assets/hero/hero-prague-640.avif 640w, /assets/hero/hero-prague-1024.avif 1024w, /assets/hero/hero-prague-1600.avif 1600w" sizes="100vw" /><source type="image/webp" srcset="/assets/hero/hero-prague-640.webp 640w, /assets/hero/hero-prague-1024.webp 1024w, /assets/hero/hero-prague-1600.webp 1600w" sizes="100vw" /><img src={section.backgroundImage} srcset="/assets/hero/hero-prague-640.jpg 640w, /assets/hero/hero-prague-1024.jpg 1024w, /assets/hero/hero-prague-1600.jpg 1600w" sizes="100vw" width="1920" height="1080" alt="Pražské střechy a historické centrum" fetchpriority="high" /></picture>:<img src={section.backgroundImage} alt="Pražské střechy a historické centrum" fetchpriority="high" />}</div><div class="wrap hero-content"><div class="kicker reveal">{section.eyebrow}</div><h1 class="reveal">{lines(section.heading).map((x:string,i:number)=><>{i>0&&<br/>}<em class={i>0?'brass':undefined}>{x}</em></>)}</h1><p class="hero-lede reveal">{section.description}</p><div class="actions reveal"><a class="btn btn-primary" href={safeHref(section.primaryButtonUrl)}>{section.primaryButtonLabel}</a><a class="btn btn-ghost" href={safeHref(section.secondaryButtonUrl)}>{section.secondaryButtonLabel}</a></div><div class="hero-proof reveal">{(section.proofItems||[]).map((x:string)=><span>{x}</span>)}</div></div></section>}
{t==='trustBar' && <section class="trust-strip"><div class="wrap trust-grid">{section.items.map((x:any)=><div class="trust-item"><b>{x.value}</b><span>{x.label}</span></div>)}</div></section>}
{t==='problemBand' && <section class="section compact"><div class="wrap"><div class="split-head"><div><div class="kicker brass">{section.eyebrow}</div><h2 class="h2" style="margin-top:20px">{section.heading}</h2></div><p class="intro-text muted">{section.description}</p></div><div class="problem-band reveal">{section.items.map((x:any)=><div class="problem"><b>{x.title}</b><p>{x.body}</p><a href={safeHref(x.url)}>{x.label}</a></div>)}</div></div></section>}
{t==='featuredProjects' && <section class="section paper"><div class="wrap"><div class="split-head"><div><div class="kicker brass">{section.eyebrow}</div><h2 class="h2" style="margin-top:20px">{section.heading}</h2></div><p class="intro-text muted">{section.description}</p></div><div class="projects-grid reveal">{featuredProjects[0]&&<a class="project-card" href={`/realizace/${featuredProjects[0].slug}/`}><img src={featuredProjects[0].heroImage} alt={featuredProjects[0].imageAlt||featuredProjects[0].title} loading="eager" /><div class="project-copy"><div class="index">01 · {featuredProjects[0].year}</div><h3>{featuredProjects[0].title}</h3><p>{featuredProjects[0].shortDescription} {featuredProjects[0].contractValue?`· ${money(featuredProjects[0].contractValue,featuredProjects[0].currency)}`:''}</p></div></a>}{featuredProjects.length>1&&<div class="project-stack">{featuredProjects.slice(1).map((p:any,i:number)=><a class="project-card small" href={`/realizace/${p.slug}/`}><img src={p.heroImage} alt={p.imageAlt||p.title} loading="lazy" /><div class="project-copy"><div class="index">{String(i+2).padStart(2,'0')} · {p.year}</div><h3>{p.title}</h3><p>{p.shortDescription} {p.contractValue?`· ${money(p.contractValue,p.currency)}`:''}</p></div></a>)}</div>}</div><a class="section-link" href="/realizace/">Všechny vybrané realizace →</a></div></section>}
{t==='processSteps' && <section class:list={['section',section.theme==='forest'?'forest':'paper']}><div class="wrap"><div class="kicker" style={section.theme==='forest'?'color:var(--brass2)':undefined}>{section.eyebrow}</div><h2 class="h2" style="margin-top:20px">{section.heading}</h2><div class="steps">{section.items.map((x:any,i:number)=><div class="step-simple"><div class="n">{String(i+1).padStart(2,'0')}</div><b>{x.title}</b><p>{x.body}</p></div>)}</div></div></section>}
{t==='subHero' && <section class:list={['subhero',section.backgroundImage&&'has-image']}>{section.backgroundImage&&<div class="bg"><img src={section.backgroundImage} alt="" fetchpriority="high" /></div>}<div class="wrap"><div class="breadcrumbs"><a href="/">Domů</a> / {section.eyebrow}</div><div class="kicker" style="margin-top:28px;color:var(--brass2)">{section.eyebrow}</div><h1>{section.heading}</h1><p>{section.description}</p></div></section>}
{t==='projectCases' && <>{projects.map((p:any,i:number)=><article class="case"><div class="wrap case-grid"><div class="case-media reveal"><img src={p.heroImage} alt={p.imageAlt||p.title} loading="lazy" />{p.imageCaption&&<div class="caption">{p.imageCaption}</div>}</div><div class="case-copy reveal"><div class="case-no">{String(i+1).padStart(2,'0')} · {p.title}</div><h2>{p.title}</h2><p class="scope">{p.shortDescription}</p><div class="fact-grid"><div class="fact"><b>{p.year}</b><span>rok zveřejněné zakázky</span></div>{p.contractValue&&<div class="fact"><b>{money(p.contractValue,p.currency)}</b><span>bez DPH</span></div>}</div><div class="actions"><a class="btn btn-dark" href={`/realizace/${p.slug}/`}>Detail realizace</a>{p.registryLinks?.[0]&&<a class="btn" style="border-color:var(--line)" href={p.registryLinks[0].url} target="_blank" rel="noopener">Veřejný záznam ↗</a>}</div></div></div></article>)}</>}
{t==='servicesDetail' && <section class="section"><div class="wrap"><div class="split-head"><div><div class="kicker brass">{section.eyebrow}</div><h2 class="h2" style="margin-top:20px">{section.heading}</h2></div><p class="intro-text muted">{section.description}</p></div>{services.map((s:any,i:number)=><article class="service-detail reveal"><div class="n">{String(i+1).padStart(2,'0')}</div><div><h2>{s.name}</h2></div><div><ul>{(s.items||[]).map((x:string)=><li>{x}</li>)}</ul></div></article>)}</div></section>}
{t==='registryReferences' && <section class="section"><div class="wrap"><div class="metric-hero"><div><div class="metric">{section.recordCount}</div><div class="kicker brass" style="margin-top:28px">zveřejněných záznamů</div></div><div><h2 class="h2">{section.heading}</h2><p class="intro-text muted" style="margin-top:28px">{section.description}</p><a class="btn btn-dark" style="margin-top:18px" href={company.registryUrl} target="_blank" rel="noopener">Otevřít všechny záznamy ↗</a></div></div><div class="ledger" style="margin-top:70px">{references.map((r:any,i:number)=><a class="ledger-row" href={r.url} target="_blank" rel="noopener"><span class="idx">{String(i+1).padStart(2,'0')}</span><strong>{r.label}</strong><span>{r.year}</span><span class="amount">{money(r.amount,r.currency)}</span><span class="arrow">↗</span></a>)}</div><p class="ledger-note">Počet záznamů v Registru smluv není vydáván za počet unikátních dokončených projektů.</p></div></section>}
{t==='companyStory' && <section class="section"><div class="wrap story-grid"><div class="story-image reveal"><img src={section.image} alt={section.imageAlt||''} loading="lazy" />{section.imageCaption&&<div class="cms-image-note">{section.imageCaption}</div>}</div><div class="story-copy reveal"><div class="kicker brass">{section.eyebrow}</div><h2 style="margin-top:18px">{section.heading}</h2><p>{section.body}</p><div class="identity"><div class="identity-row"><span>Název</span><span>{company.legalName}</span></div><div class="identity-row"><span>IČO</span><span>{company.ico}</span></div><div class="identity-row"><span>Vznik</span><span>{company.founded}</span></div><div class="identity-row"><span>Sídlo</span><span>{company.address}</span></div><div class="identity-row"><span>Obor</span><span>{company.trade}</span></div></div></div></div></section>}
{t==='contactForm' && <ContactForm heading={section.heading} />}
{t==='richText' && <section class="section"><div class="wrap rich-copy"><h2 class="h2" style="font-size:52px">{section.heading}</h2>{section.paragraphs.map((p:string)=><p>{p}</p>)}</div></section>}
{t==='gallery' && <section class="section"><div class="wrap"><div class="kicker brass">{section.eyebrow}</div><h2 class="h2" style="margin-top:20px">{section.heading}</h2><div class="gallery-grid">{(section.images||[]).map((img:any)=><figure><img src={img.src} alt={img.alt||''} loading="lazy" />{img.caption&&<figcaption class="small muted">{img.caption}</figcaption>}</figure>)}</div></div></section>}
{t==='beforeAfter' && <section class="section paper"><div class="wrap"><h2 class="h2">{section.heading}</h2><div class="before-after">{section.beforeImage&&<figure><img src={section.beforeImage} alt={section.beforeAlt||'Před opravou'} /><figcaption class="small muted">Před</figcaption></figure>}{section.afterImage&&<figure><img src={section.afterImage} alt={section.afterAlt||'Po opravě'} /><figcaption class="small muted">Po</figcaption></figure>}</div></div></section>}
{t==='faq' && <section class="section"><div class="wrap"><h2 class="h2">{section.heading}</h2><div class="faq">{(section.items||[]).map((x:any)=><details><summary>{x.question}</summary><p>{x.answer}</p></details>)}</div></div></section>}
{t==='spacer' && <div aria-hidden="true" style={`height:${Math.max(16,Math.min(180,Number(section.height)||48))}px`}></div>}
{t==='contactCta' && <section class="final-cta"><div class="wrap final-grid"><div><div class="kicker" style="color:var(--brass2)">{section.eyebrow}</div><h2>{lines(section.heading).map((x:string,i:number)=><>{i>0&&<br/>}<em class={i>0?'':undefined}>{x}</em></>)}</h2></div><div class="final-contact"><a class="btn btn-primary" href={safeHref(section.primaryUrl)}>{section.primaryLabel}</a>{section.secondaryLabel&&<a class="section-link" style="color:var(--brass2);display:block" href={safeHref(section.secondaryUrl)}>{section.secondaryLabel} →</a>}</div></div></section>}
