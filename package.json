{
  "name": "zavady-strech-cms-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:worker": "tinacms dev -c \"wrangler dev\"",
    "build": "tinacms build -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks && astro build",
    "build:astro": "astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && astro check",
    "test": "node --test tests/*.test.mjs",
    "audit": "node tests/audit.mjs",
    "validate": "npm run test && npm run audit && npm run typecheck && npm run build:local",
    "postinstall": "node scripts/patch-tina-zod4.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@tinacms/astro": "0.6.1",
    "@tinacms/auth": "1.1.5",
    "astro": "7.4.2",
    "tinacms": "3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tinacms/cli": "4.0.3",
    "@types/node": "^22.13.1",
    "prettier": "3.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.2",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "dompurify": "^3.4.17",
    "undici": "7.30.1",
    "katex": "0.18.2",
    "zod": "4.6.7"
  }
}
