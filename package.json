{
  "name": "zavady-strech-cms-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tinacms dev -c \"astro dev\"",
    "dev:worker": "tinacms dev -c \"wrangler dev\"",
    "build": "tinacms build --content=local -c \"astro build\"",
    "build:local": "tinacms build --local --skip-cloud-checks && astro build",
    "build:astro": "astro build",
    "preview": "wrangler dev",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "cf-typegen": "wrangler types",
    "typecheck": "npm run cf-typegen && astro check",
    "test": "node --test tests/*.test.mjs",
    "audit": "node tests/audit.mjs",
    "validate": "npm run test && npm run audit && npm run typecheck && npm run build:local"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@tinacms/astro": "0.6.1",
    "@tinacms/auth": "1.1.3",
    "astro": "7.2.9",
    "tinacms": "3.12.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tinacms/cli": "2.6.1",
    "@types/node": "^22.13.1",
    "prettier": "3.9.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "5.9.2",
    "wrangler": "4.125.0"
  }
}
